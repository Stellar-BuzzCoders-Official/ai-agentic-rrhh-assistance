# ==============================================================================
# CONFIGURACIÓN DEL ASISTENTE DE RRHH (LANGGRAPH + AZURE)
# Copia este archivo a .env y completa los valores correspondientes.
# ==============================================================================

# Entorno general
ENVIRONMENT=development
APP_NAME="RRHH Screening Assistance API"
DEBUG=true
PORT=5000
HOST=0.0.0.0

# Conmutadores de Arquitectura Hexagonal
# LLM_PROVIDER: azure_openai | gemini | ollama
LLM_PROVIDER=azure_openai
JUDGE_LLM_PROVIDER=azure_openai
EMBEDDING_PROVIDER=azure_openai

# STORAGE_PROVIDER: blob | minio | memory
STORAGE_PROVIDER=blob

# PERSISTENCE_PROVIDER: cosmos | memory
PERSISTENCE_PROVIDER=cosmos

# EXTRACTOR_PROVIDER: document_intelligence | legacy_local
EXTRACTOR_PROVIDER=document_intelligence

# SAFETY_PROVIDER: azure | noop
SAFETY_PROVIDER=noop

# AUTH_PROVIDER: entra_id | dev
AUTH_PROVIDER=dev

# Límites
BULK_UPLOAD_MAX_FILES=10
MAX_RELEVANT_CANDIDATES=5
EMBEDDING_DIMENSIONS=1536

# ------------------------------------------------------------------------------
# 1. AZURE OPENAI
# ------------------------------------------------------------------------------
AZURE_ENDPOINT=https://<tu-recurso>.openai.azure.com/
AZURE_API_KEY=<tu-azure-openai-api-key>
AZURE_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ------------------------------------------------------------------------------
# 2. AZURE COSMOS DB (API NoSQL)
# ------------------------------------------------------------------------------
COSMOS_ENDPOINT=https://<tu-cuenta-cosmos>.documents.azure.com:443/
COSMOS_KEY=<tu-clave-primaria-cosmos>
# Opcional si usas Connection String:
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://...;AccountKey=...;
COSMOS_DATABASE_NAME=rrhh
COSMOS_CHECKPOINTS_CONTAINER=checkpoints
COSMOS_THREADS_CONTAINER=threads
COSMOS_USERS_CONTAINER=users
COSMOS_CANDIDATES_CONTAINER=candidates
COSMOS_FILES_CONTAINER=files

# ------------------------------------------------------------------------------
# 3. AZURE BLOB STORAGE
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_ACCOUNT_NAME=<nombre-de-cuenta>
AZURE_STORAGE_ACCOUNT_KEY=<clave-de-cuenta>
AZURE_STORAGE_CONTAINER_NAME=rrhh-documents

# ------------------------------------------------------------------------------
# 4. AZURE AI DOCUMENT INTELLIGENCE
# ------------------------------------------------------------------------------
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<tu-recurso-doc-intel>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=<tu-clave-document-intelligence>

# ------------------------------------------------------------------------------
# 5. AZURE AI CONTENT SAFETY (Opcional)
# ------------------------------------------------------------------------------
CONTENT_SAFETY_ENDPOINT=https://<tu-recurso-content-safety>.cognitiveservices.azure.com/
CONTENT_SAFETY_KEY=<tu-clave-content-safety>

# ------------------------------------------------------------------------------
# 6. MICROSOFT ENTRA ID
# ------------------------------------------------------------------------------
ENTRA_TENANT_ID=<tu-tenant-id-azure-ad>
ENTRA_CLIENT_ID=<tu-client-id-api>
ENTRA_AUDIENCE=api://<tu-client-id-api>

# ------------------------------------------------------------------------------
# 7. PROVEEDORES ALTERNATIVOS (OPCIONALES)
# ------------------------------------------------------------------------------
# Google Gemini:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# MinIO (legacy):
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=document-bucket
MINIO_SECURE=false